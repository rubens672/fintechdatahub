# ==============================================================================
# secret-cloudflare-tunnel.yaml.example — Esempio Template Secret Cloudflare Tunnel
# ==============================================================================
# NOTA DI SICUREZZA: Non committare MAI le credenziali reali su Git!
# Per applicare il secret nel cluster GKE eseguire da terminale:
#   kubectl create secret generic cloudflare-tunnel-token \
#     --from-literal=token="<IL_TUO_CLOUDFLARE_TUNNEL_TOKEN>" \
#     -n fintech-platform
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-tunnel-token
  namespace: fintech-platform
  labels:
    app.kubernetes.io/name: cloudflared
    app.kubernetes.io/part-of: fintech-platform
type: Opaque
stringData:
  token: "CLOUDFLARE_TUNNEL_TOKEN_PLACEHOLDER"
